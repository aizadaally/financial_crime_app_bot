# From @BotFather. NEVER commit the real value.
BOT_TOKEN=123456:replace-me-with-your-real-token-from-botfather
# Strongly recommended: only these chat ids are moderated; the bot leaves any other chat it is added to.
# Find a group's id by adding @RawDataBot temporarily, or from the bot's log line "added to unapproved chat <id>".
ALLOWED_CHAT_IDS=
# Optional: chat id where ban reports are sent (links in reports are made non-clickable)
LOG_CHAT_ID=
# true = only log/report, never delete or ban. START WITH true.
DRY_RUN=true
# Message is removed + sender banned when score >= BAN_SCORE
BAN_SCORE=4
# Comma-separated t.me usernames of your own groups that are never treated as spam links
ALLOWED_DOMAINS=
# Comma-separated telegram user ids that are never moderated (admins are always skipped)
WHITELIST_USER_IDS=
# Optional JSON file with extra rules (validated against slow/ReDoS patterns)
EXTRA_RULES_FILE=
# true = log every group message the bot sees (score only, no text). Helps debugging.
LOG_ALL=false
# Seconds to wait before deleting/banning (0 = instant, max 30). Use 2-3 when recording a demo.
DELETE_DELAY_SECONDS=0

# ---------- Optional "smart" AI layer (Claude). OFF by default ----------
# When on, suspicious-looking messages (rules flagged them, or they contain a link/@contact/phone/amount)
# have their TEXT ONLY sent to Anthropic's API to be classified. Tell your group members if you enable it.
AI_ENABLED=false
# Get a key at console.anthropic.com. Never commit it.
ANTHROPIC_API_KEY=
# suspicious (default) | borderline (only if rules scored >=1) | all (every message >=20 chars, costs more)
AI_MODE=suspicious
# Model used for the check. claude-opus-5-5 is the default; claude-haiku-5-5 is much cheaper and fine for most chats.
AI_MODEL=claude-opus-5-5
# Hard cap on AI calls per minute (cost protection)
AI_MAX_CALLS_PER_MINUTE=30
