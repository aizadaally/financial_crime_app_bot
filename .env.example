BOT_TOKEN=123456:replace-me
# Optional: chat id (group/channel/user) where ban reports are sent
LOG_CHAT_ID=
# Message is removed + sender banned when score >= BAN_SCORE
BAN_SCORE=4
# Comma-separated domains / t.me usernames that are never treated as spam links
ALLOWED_DOMAINS=
# Comma-separated telegram user ids that are never moderated (admins are always skipped)
WHITELIST_USER_IDS=
# Optional JSON file with extra rules (see README)
EXTRA_RULES_FILE=
# true = only log/report, never delete or ban (use while testing)
DRY_RUN=false
